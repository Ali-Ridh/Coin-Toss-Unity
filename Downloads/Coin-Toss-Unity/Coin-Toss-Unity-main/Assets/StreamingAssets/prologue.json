    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/heroines/sprite/bulan",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Narrator",
    "dialogueText": "[Seketika mereka semua menoleh ke arah yang ditunjuk oleh Bulan. Terlihat pasukan robot bergerak mendekati Warkop.]",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
