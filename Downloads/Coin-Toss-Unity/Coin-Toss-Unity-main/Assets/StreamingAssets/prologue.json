    "leftPortrait": "characters/fix/mainCharacters/sprite/raden",
    "rightPortrait": "",
    "speakerPosition": "left",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Ibu",
    "dialogueText": "Cepat kamu masuk ke dalam sekarang!",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/ibu",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Agung",
    "dialogueText": "(Bergegas lari keluar) Ada apa ini?",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/bapak",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Raden",
    "dialogueText": "Tenang pak, bu. Aku bisa melawan robot-robot itu. Sudah lama aku mau menggunakan kekuatanku, akhirnya bisa ku pakai untuk melawan mereka.",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "characters/fix/mainCharacters/sprite/raden",
    "rightPortrait": "",
    "speakerPosition": "left",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Narrator",
    "dialogueText": "[Tanpa pikir panjang, Raden langsung berubah ke pakaian supernya dan beranjak untuk melawan pasukan robot yang mendekat.]",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "",
    "speakerPosition": "",
    "choices": [],
    "actionType": 1
  },
  {
    "speaker": "Sri",
    "dialogueText": "Aduh mas, ayo kita kesana sekarang. Raden butuh bantuan kita, dia belum siap untuk menggunakan kekuatannya!",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/ibu",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Agung",
    "dialogueText": "Ayo Sri, semakin lama kita mengulur waktu semakin berbahaya untuk Raden!",
