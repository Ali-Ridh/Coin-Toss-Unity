    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/bapak",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Sri",
    "dialogueText": "(Menoleh ke arah Bulan) Bulan, maaf ya. Saya titip dulu Warkop ini ke kamu.",
    "emotionIndex": 0,
