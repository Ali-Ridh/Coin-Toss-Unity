    "leftPortrait": "",
    "rightPortrait": "characters/fix/heroines/sprite/bulan",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Narrator",
    "dialogueText": "[Agung dan Sri mulai menyerbu para robot. Namun, mereka mulai kewalahan menghadapi jumlah robot yang terus berdatangan.]",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "",
    "speakerPosition": "",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Sri",
    "dialogueText": "Mas, kenapa robotnya terus berdatangan. Tidak ada habisnya mereka!",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/ibu",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
    "speaker": "Agung",
    "dialogueText": "Bertahan Sri, pasti kita bisa mengalahkan mereka semua. Kita pernah melawan musuh yang lebih sulit dari ini!",
    "emotionIndex": 0,
    "background": "ui/background/VN_StreetsEvening",
    "voiceClip": "",
    "leftPortrait": "",
    "rightPortrait": "characters/fix/mainCharacters/sprite/bapak",
    "speakerPosition": "right",
    "choices": [],
    "actionType": 0
  },
  {
